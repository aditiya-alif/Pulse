<?xml version="1.0" encoding="utf-8"?>
<!-- The Pulse mark: the same trace the splash screen draws, in the app's own
     accent blue on the app's own dark surface. The shape is the splash's own path
     - flat lead-in, a dip, a tall spike, a dip, flat lead-out - so the icon and
     the splash are recognisably the same signal. Scaled into the adaptive-icon
     safe zone (the inner circle), so no launcher mask crops the beat. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M22,54 L32,54 L38.6,73 L49.6,32 L60.6,66 L69.4,54 L86,54"
        android:strokeColor="#3987E5"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
